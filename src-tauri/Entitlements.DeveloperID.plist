<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Developer ID direct-distribution entitlements: non-sandboxed, Hardened
     Runtime. Selected by .github/workflows/{release,build}.yml via an inline
     `bundle.macOS.entitlements` override; it does NOT use the base
     tauri.conf.json (which stays on the sandboxed Entitlements.plist for the
     App Store build). The two files are independent on purpose — keep both.

     Non-sandboxed is intentional: the app shells out to /usr/bin/caffeinate
     (sleep prevention during live transcription) and reads gethostuuid(),
     which the App Sandbox would block. Keychain access here is ACL-bound to
     this Developer ID signing identity (stable across releases → no repeated
     prompts once an item is created by a signed build). -->
<plist version="1.0">
<dict>
    <!-- Hardened Runtime: required for Tauri WebView JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- llama.cpp Metal JIT / WebKit paths may allocate unsigned executable pages -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Bundled / third-party dylibs (sherpa-onnx, llama.cpp Metal, WebKit) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Outbound network (API calls, SSO login, model downloads) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- OAuth2 loopback redirect (Google Calendar login) -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- File downloads (mail attachments, Luna course materials) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- User-selected download directory via file dialog -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Real-time STT (SenseVoice) captures from the default input device -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Debug-only osascript notification fallback (ai.rs) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
